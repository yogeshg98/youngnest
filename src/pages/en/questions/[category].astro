---
import '@fontsource-variable/inter'; import '../../../styles/global.css';
import SiteHeader from '../../../components/SiteHeader.astro'; import SiteFooter from '../../../components/SiteFooter.astro'; import FaqList from '../../../components/FaqList.astro'; import Icon from '../../../components/Icon.astro';
import { faqCategories } from '../../../data/faqs'; import { site } from '../../../data/site';
export function getStaticPaths() { return faqCategories.map(category => ({ params: { category: category.slug }, props: { category } })); }
const { category } = Astro.props;
const schema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: category.questions.map((faq: any) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><meta name="description" content={category.description}/><link rel="canonical" href={`${site.origin}/en/questions/${category.slug}`}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><title>{category.titleTag}</title><script type="application/ld+json" set:html={JSON.stringify(schema)}></script></head><body><a class="skip-link" href="#main">Skip to content</a><SiteHeader/><main id="main" class="faq-page container"><a class="breadcrumb" href="/en/questions">FAQ Home</a><p class="eyebrow">YoungNest FAQ · {category.questions.length} questions</p><h1>{category.title}</h1><p class="faq-lead">{category.intro}</p><p class="faq-reviewed">Last reviewed: {site.faqReviewed}</p><FaqList questions={category.questions} category={category.title}/><section class="faq-hub-contact"><h2>Ready to take the next step?</h2><p>Send us your move-in date and what you’re looking for.</p><a class="button" href="/#enquire">Enquire now <Icon name="arrow" size={20}/></a></section></main><SiteFooter/><script src="../../../scripts/faq-page.ts"></script></body></html>
