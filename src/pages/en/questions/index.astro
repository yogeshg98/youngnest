---
import '@fontsource-variable/inter'; import '../../../styles/global.css';
import SiteHeader from '../../../components/SiteHeader.astro'; import SiteFooter from '../../../components/SiteFooter.astro'; import Icon from '../../../components/Icon.astro';
import { faqCategories, allFaqs } from '../../../data/faqs'; import { site } from '../../../data/site';
const searchIndex = allFaqs.map(({ id, question, answer, keywords, category, slug, url }) => ({ id, question, answer, keywords, category, slug, url }));
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><meta name="description" content="Renting, arriving, registering and living in a YoungNest shared house near Munich. Fifty-one questions answered in plain English."/><link rel="canonical" href={`${site.origin}/en/questions`}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><title>Questions, answered | YoungNest Ottobrunn</title></head><body><a class="skip-link" href="#main">Skip to content</a><SiteHeader/><main id="main" class="faq-hub container"><p class="eyebrow">YoungNest FAQ</p><h1>Questions, answered</h1><p class="faq-lead">Renting a room in Germany involves more paperwork than most people expect, and most of it is only confusing the first time. These are the questions we actually get asked, grouped so you can find yours quickly. If something is missing, message us and we will answer it here as well as to you.</p><section class="faq-search" aria-label="Search frequently asked questions"><label for="faq-search-input">Search {allFaqs.length} questions</label><div class="faq-search-input"><Icon name="search" size={19}/><input id="faq-search-input" type="search" autocomplete="off" placeholder={`Search ${allFaqs.length} questions`} role="combobox" aria-expanded="false" aria-controls="faq-search-results" aria-autocomplete="list"/></div><p id="faq-search-status" class="sr-only" role="status" aria-live="polite"></p><div id="faq-search-results" class="faq-search-results" role="listbox" hidden></div><script type="application/json" id="faq-search-index" set:html={JSON.stringify(searchIndex)}></script></section><section class="faq-categories" aria-label="FAQ categories">{faqCategories.map(category => <a class="faq-category-card" href={`/en/questions/${category.slug}`}><Icon name="book" size={21}/><span class="faq-category-count">{category.questions.length} questions</span><h2>{category.title}</h2><p>{category.example}</p></a>)}</section><section class="faq-hub-contact"><h2>Still have a question?</h2><p>We’re happy to help you find the right answer.</p><a class="button" href="/#enquire">Enquire now <Icon name="arrow" size={20}/></a></section></main><SiteFooter/><script src="../../../scripts/faq-search.ts"></script></body></html>
